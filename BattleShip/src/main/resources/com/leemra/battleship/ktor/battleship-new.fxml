<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.leemra.battleship.ktor.KtorGameController">
   <children>
      <GridPane alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" prefHeight="500.0" VBox.vgrow="ALWAYS">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="-Infinity" prefHeight="50.0" vgrow="NEVER" />
          <RowConstraints prefHeight="400.0" valignment="CENTER" vgrow="NEVER" />
          <RowConstraints maxHeight="1.7976931348623157E308" minHeight="-Infinity" prefHeight="50.0" valignment="BOTTOM" vgrow="ALWAYS" />
        </rowConstraints>
         <children>
            <Label text="Player Board" GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS" GridPane.valignment="CENTER" GridPane.vgrow="ALWAYS">
               <font>
                  <Font size="25.0" />
               </font>
            </Label>
            <Label text="Computer Board" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS" GridPane.valignment="CENTER" GridPane.vgrow="ALWAYS">
               <font>
                  <Font size="25.0" />
               </font>
            </Label>
            <GridPane fx:id="playerPanel" alignment="CENTER" hgap="1.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="400.0" vgap="1.0" GridPane.columnIndex="0" GridPane.halignment="CENTER" GridPane.rowIndex="1" VBox.vgrow="NEVER">
                <children>

                </children>
            </GridPane>
            <GridPane fx:id="cpuPanel" alignment="CENTER" hgap="1.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="400.0" vgap="1.0" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="1" VBox.vgrow="NEVER">
                <children>

                </children>
            </GridPane>
            <HBox alignment="BOTTOM_LEFT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" prefHeight="100.0" prefWidth="200.0" GridPane.hgrow="ALWAYS" GridPane.rowIndex="2" GridPane.valignment="BOTTOM" GridPane.vgrow="ALWAYS">
               <children>
                  <Label fx:id="status" text="Place a Cruiser">
                     <HBox.margin>
                        <Insets bottom="15.0" left="20.0" right="20.0" />
                     </HBox.margin>
                  </Label>
                  <ToggleButton fx:id="vertical" mnemonicParsing="false" prefHeight="40.0" prefWidth="40.0" selected="true" text="|">
                     <toggleGroup>
                        <ToggleGroup fx:id="direction" />
                     </toggleGroup>
                     <HBox.margin>
                        <Insets bottom="5.0" right="10.0" />
                     </HBox.margin>
                  </ToggleButton>
                  <ToggleButton fx:id="horizontal" mnemonicParsing="false" prefHeight="40.0" prefWidth="40.0" text="--" toggleGroup="$direction">
                     <HBox.margin>
                        <Insets bottom="5.0" right="10.0" />
                     </HBox.margin>
                  </ToggleButton>
               </children>
               <GridPane.margin>
                  <Insets />
               </GridPane.margin></HBox>
            <HBox alignment="BOTTOM_RIGHT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="2" GridPane.valignment="BOTTOM" GridPane.vgrow="ALWAYS">
             <MenuButton mnemonicParsing="false" popupSide="TOP" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 4px 8px;" text="Theme" BorderPane.alignment="CENTER">
                 <items>
                     <RadioMenuItem mnemonicParsing="false" onAction="#onThemeChange" text="Cupertino" selected="true">
                         <toggleGroup>
                             <ToggleGroup fx:id="theme" />
                         </toggleGroup>
                     </RadioMenuItem>
                     <RadioMenuItem mnemonicParsing="false" onAction="#onThemeChange" text="Dracula" toggleGroup="$theme" />
                     <RadioMenuItem mnemonicParsing="false" onAction="#onThemeChange" text="Nord" toggleGroup="$theme" />
                     <RadioMenuItem mnemonicParsing="false" onAction="#onThemeChange" text="Primer" toggleGroup="$theme" />
                     <SeparatorMenuItem />
                     <RadioMenuItem mnemonicParsing="false" onAction="#onThemeChange" text="Light">
                         <toggleGroup>
                             <ToggleGroup fx:id="color" />
                         </toggleGroup></RadioMenuItem>
                     <RadioMenuItem mnemonicParsing="false" onAction="#onThemeChange" text="Dark" selected="true" toggleGroup="$color" />
                 </items>
                 <BorderPane.margin>
                     <Insets bottom="10.0" />
                 </BorderPane.margin>
                  <HBox.margin>
                     <Insets bottom="5.0" />
                  </HBox.margin>
             </MenuButton>
               <Button minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#onQuitClick" prefHeight="40.0" prefWidth="100.0" text="Quit">
                  <HBox.margin>
                     <Insets bottom="5.0" left="20.0" right="20.0" />
                  </HBox.margin>
               </Button>
             </HBox>
         </children>
      </GridPane>
   </children>
</VBox>
